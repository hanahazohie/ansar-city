[Unit]
Description=Crayon City (drawings that drive)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/crayon-city
EnvironmentFile=/home/ubuntu/crayon-city/.env
ExecStart=/home/ubuntu/crayon-city/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
